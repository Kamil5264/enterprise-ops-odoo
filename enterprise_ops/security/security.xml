<odoo>

    <!-- ===================== Module Category ===================== -->
    <record id="module_category_enterprise_ops" model="ir.module.category">
        <field name="name">Enterprise Operations</field>
        <field name="description">Access rights for the Enterprise Operations &amp; Procurement app.</field>
        <field name="sequence">20</field>
    </record>

    <!-- ===================== Privilege (Odoo 19) ===================== -->
    <!-- New in Odoo 19: res.groups no longer links directly to
         ir.module.category. Instead, groups link to a res.groups.privilege
         record, and the privilege links to the category. All 5 of our
         groups share this one privilege, so they render as one
         hierarchical radio-selector in Settings > Users. -->
    <record id="privilege_enterprise_ops" model="res.groups.privilege">
        <field name="name">Enterprise Operations</field>
        <field name="category_id" ref="module_category_enterprise_ops"/>
    </record>

    <!-- ===================== Groups ===================== -->
    <record id="group_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="privilege_id" ref="privilege_enterprise_ops"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can create and manage their own requests.</field>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_enterprise_ops"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
        <field name="comment">Can approve/reject submitted requests, in addition to Employee rights.</field>
    </record>

    <record id="group_procurement" model="res.groups">
        <field name="name">Procurement</field>
        <field name="privilege_id" ref="privilege_enterprise_ops"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
        <field name="comment">Processes approved requests through to procurement.</field>
    </record>

    <record id="group_finance" model="res.groups">
        <field name="name">Finance</field>
        <field name="privilege_id" ref="privilege_enterprise_ops"/>
        <field name="implied_ids" eval="[(4, ref('group_employee'))]"/>
        <field name="comment">Read-only visibility for accounting and audit purposes.</field>
    </record>

    <record id="group_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="privilege_enterprise_ops"/>
        <field name="implied_ids" eval="[(4, ref('group_manager')),
                                          (4, ref('group_procurement')),
                                          (4, ref('group_finance'))]"/>
        <field name="comment">Full access, including master data management.</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <record id = "rule_request_employee" model = "ir.rule">
         <field name = "name">Request:Employees sees own request only</field>
         <field name = "model_id" ref = "model_enterprise_ops_request"/>
         <field name = "domain_force">[('employee_id', '=', user.id)]</field>
         <field name = "groups" eval = "[(4,ref('group_employee'))]"/>
  </record>

  <record id="rule_request_manager" model="ir.rule">
        <field name="name">Request: Manager sees own + managed-department requests</field>
        <field name="model_id" ref="model_enterprise_ops_request"/>
        <field name="domain_force">['|', ('employee_id', '=', user.id), ('department_id.manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>

    <record id="rule_request_admin" model="ir.rule">
        <field name="name">Request: Administrator sees all</field>
        <field name="model_id" ref="model_enterprise_ops_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin'))]"/>
    </record>

    <record id="rule_request_line_employee" model="ir.rule">
        <field name="name">Request Line: Employee sees own request's lines only</field>
        <field name="model_id" ref="model_enterprise_ops_request_line"/>
        <field name="domain_force">[('request_id.employee_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_employee'))]"/>
    </record>

    <record id="rule_request_line_manager" model="ir.rule">
        <field name="name">Request Line: Manager sees own + managed-department lines</field>
        <field name="model_id" ref="model_enterprise_ops_request_line"/>
        <field name="domain_force">['|', ('request_id.employee_id', '=', user.id), ('request_id.department_id.manager_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_manager'))]"/>
    </record>

    <record id="rule_request_line_admin" model="ir.rule">
        <field name="name">Request Line: Administrator sees all</field>
        <field name="model_id" ref="model_enterprise_ops_request_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_admin'))]"/>
    </record>

</odoo>