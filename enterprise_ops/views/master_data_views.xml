<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== Operating Unit ===================== -->
    <record id="view_operating_unit_list" model="ir.ui.view">
        <field name="name">enterprise.ops.operating.unit.list</field>
        <field name="model">enterprise.ops.operating.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_operating_unit_form" model="ir.ui.view">
        <field name="name">enterprise.ops.operating.unit.form</field>
        <field name="model">enterprise.ops.operating.unit</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_operating_unit" model="ir.actions.act_window">
        <field name="name">Operating Units</field>
        <field name="res_model">enterprise.ops.operating.unit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_operating_unit"
              name="Operating Units"
              parent="menu_enterprise_ops_config"
              action="action_operating_unit"
              sequence="10"/>

    <!-- ===================== Department ===================== -->
    <record id="view_department_list" model="ir.ui.view">
        <field name="name">enterprise.ops.department.list</field>
        <field name="model">enterprise.ops.department</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_department_form" model="ir.ui.view">
        <field name="name">enterprise.ops.department.form</field>
        <field name="model">enterprise.ops.department</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="manager_id"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">enterprise.ops.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_department"
              name="Departments"
              parent="menu_enterprise_ops_config"
              action="action_department"
              sequence="20"/>

</odoo>