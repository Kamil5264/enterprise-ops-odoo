<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===================== List View ===================== -->
    <record id="view_request_list" model="ir.ui.view">
        <field name="name">enterprise.ops.request.list</field>
        <field name="model">enterprise.ops.request</field>
        <field name="arch" type="xml">
            <list  decoration-info="state == 'draft'"
                  decoration-warning="state == 'submitted'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'done'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="request_date"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'submitted'"
                       decoration-success="state == 'approved'"
                       decoration-danger="state == 'rejected'"/>
                <field name="company_id" groups="base.group_multi_company"/>
                 <field name="amount_total" sum="Total"/>
            </list>
        </field>
    </record>

    <!-- ===================== Form View ===================== -->
    <record id="view_request_form" model="ir.ui.view">
        <field name="name">enterprise.ops.request.form</field>
        <field name="model">enterprise.ops.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" type="object" string="Submit"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'submitted'"/>
                    <button name="action_send_to_procurement" type="object"
                            string="Send to Procurement" class="btn-primary"
                            invisible="state != 'approved'"/>
                    <button name="action_done" type="object" string="Mark Done"
                            class="btn-primary" invisible="state != 'procurement'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state not in ('rejected', 'cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved,procurement,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"
                                   domain="[('company_id', '=', company_id)]"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="priority" widget="priority"/>
                            <field name="request_date"/>
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1"/>
                    </group>
                    <notebook>
                      <page string = "Lines" name = "lines">
                        <field name = "line_ids"> 
                           <list editable = "bottom"> 
                           <field name = "sequence" widget = "handle"/> 
                           <field name = "product_name"/>
                           <field name = "quantity"/>
                           <field name = "estimated_unit_price"/>
                           <field name = "notes"/>
                           <field name = "currency_id" column_visible = "1"/>
                           <field name = "subtotal" sum = "Total"/>
                           </list>
                      </field>
                       </page>
                    </notebook>
                                       <group name="totals" class="oe_right" col="2">
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_lines_total" readonly="1"/>
                        <field name="amount_additional_charges"/>
                        <field name="amount_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


        <record id="view_request_kanban" model="ir.ui.view">
        <field name="name">enterprise.ops.request.kanban</field>
        <field name="model">enterprise.ops.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="False"
                    groups_draggable="False">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="d-flex justify-content-between">
                                <strong><field name="name"/></strong>
                                <field name="priority" widget="priority"/>
                            </div>
                            <div>
                                <field name="employee_id"/>
                            </div>
                            <div class="text-muted">
                                <field name="department_id"/>
                            </div>
                            <div class="d-flex justify-content-between mt-2">
                                <field name="request_date"/>
                                <field name="amount_total" widget="monetary"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    

    <!-- ===================== Action ===================== -->
    <record id="action_enterprise_ops_request" model="ir.actions.act_window">
        <field name="name">Requests</field>
        <field name="res_model">enterprise.ops.request</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="view_request_search"/>
        <field name="context">{'search_default_my_requests': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first operational request
            </p>
        </field>
    </record>

</odoo>