<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_enterprise_ops_request" model="ir.sequence">
        <field name="name">Operational Request</field>
        <field name="code">enterprise.ops.request</field>
        <field name="prefix">REQ/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="use_date_range" eval="True"/>
        <!-- Shared across companies. A company-specific override can be
             added later by creating another sequence with the same code
             and a company_id: next_by_code() prefers the company match. -->
        <field name="company_id" eval="False"/>
    </record>

</odoo>